{
  "name": "voxelon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "worldgen-smoke": "esbuild scripts/worldgen_smoke.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/worldgen-smoke.cjs --log-level=error && node node_modules/.tmp/worldgen-smoke.cjs",
    "dev": "vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "server": "esbuild server/server.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/server.cjs --external:ws --log-level=error && node node_modules/.tmp/server.cjs",
    "host": "npm run build && npm run server",
    "brand": "node scripts/make_brand.mjs",
    "og-image": "node scripts/make_brand.mjs",
    "smoke": "esbuild scripts/smoke.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/smoke.cjs --log-level=error && node node_modules/.tmp/smoke.cjs",
    "boss-smoke": "esbuild scripts/boss_smoke.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/boss-smoke.cjs --log-level=error && node node_modules/.tmp/boss-smoke.cjs",
    "music-smoke": "esbuild scripts/boss_music_smoke.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/boss-music-smoke.cjs --log-level=error && node node_modules/.tmp/boss-music-smoke.cjs",
    "warfare-smoke": "esbuild scripts/warfare_smoke.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/warfare-smoke.cjs --log-level=error && node node_modules/.tmp/warfare-smoke.cjs",
    "duels-smoke": "esbuild scripts/duels_smoke.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/duels-smoke.cjs --log-level=error && node node_modules/.tmp/duels-smoke.cjs",
    "politics-smoke": "esbuild scripts/politics_smoke.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/politics-smoke.cjs --log-level=error && node node_modules/.tmp/politics-smoke.cjs",
    "minigame-smoke": "esbuild scripts/minigame_isolation_smoke.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/minigame-smoke.cjs --log-level=error && node node_modules/.tmp/minigame-smoke.cjs",
    "party-smoke": "esbuild scripts/partygames_smoke.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/party-smoke.cjs --log-level=error && node node_modules/.tmp/party-smoke.cjs",
    "parkour-smoke": "esbuild scripts/parkour_smoke.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/parkour-smoke.cjs --log-level=error && node node_modules/.tmp/parkour-smoke.cjs",
    "boss-visual-smoke": "esbuild scripts/boss_visual_smoke.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/boss-visual-smoke.cjs --log-level=error && node node_modules/.tmp/boss-visual-smoke.cjs"
  },
  "dependencies": {
    "three": "^0.165.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.42",
    "@types/three": "^0.165.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.4.5",
    "vite": "^5.2.0"
  }
}
