{
  "name": "VOXELON",
  "short_name": "VOXELON",
  "description": "A browser voxel war game: mine deep, build high and take ground on one shared 5000-block map that never resets.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "landscape",
  "background_color": "#05070c",
  "theme_color": "#05070c",
  "icons": [
    { "src": "/favicon.svg", "type": "image/svg+xml", "sizes": "any", "purpose": "any" },
    { "src": "/icon-192.png", "type": "image/png", "sizes": "192x192" },
    { "src": "/icon-512.png", "type": "image/png", "sizes": "512x512" }
  ]
}
